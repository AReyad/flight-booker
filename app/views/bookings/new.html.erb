<div>
  <%= render "/flight" %>
</div>
<%= form_for @booking, data: { controller: "booking", booking_target: "form", booking_index_value: params[:passengers_count] } do |f| %>
  <%= f.hidden_field :flight_id, value: params[:flight] %>
  <template id="passengers-template" data-booking-target="template">
  <%= f.fields_for :passengers do |passenger| %>
      <div class="passenger">
      <p>Passenger information:</p>
        <div>
          <%= passenger.label :name %>
          <%= passenger.text_field :name, required: true %>
        </div>
        <div>
          <%= passenger.label :email %>
          <%= passenger.email_field :email, required: true %>
        </div>
        <button data-action="booking#delete:prevent">Delete</button>
      </div>
    <% end %>
  </template>
    <button data-action="booking#insert:prevent" data-booking-target="button">New passenger</button>
  <%= f.submit value: "Book Tickets" %>
<% end %>